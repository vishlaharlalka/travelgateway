# Cloudflare Pages Function email settings for /api/inquiry.
# Add these in Cloudflare Pages > Settings > Environment variables.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
INQUIRY_TO_EMAIL="info@travelgateway.in"
INQUIRY_FROM_EMAIL="Travel Gateway <inquiry@travelgateway.in>"

# Public website URL after launch.
APP_URL="https://travelgateway.in"

# Optional public payment settings used by /payment.
# Prefer VITE_RAZORPAY_PAYMENT_LINK for a fixed Razorpay payment link.
# Use VITE_RAZORPAY_PAYMENT_BUTTON_ID only when Razorpay provides a current Payment Button id.
VITE_RAZORPAY_PAYMENT_LINK=""
VITE_RAZORPAY_PAYMENT_BUTTON_ID=""
